# MQTT (HiveMQ Cloud)
MQTT_BROKER=YOUR-CLUSTER-ID.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your_mqtt_user
MQTT_PASS=your_mqtt_password

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change_me_strong_password
DOCKER_INFLUXDB_INIT_ORG=Work
DOCKER_INFLUXDB_INIT_BUCKET=Weight
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=change_me_long_random_token

# ngrok
NGROK_AUTHTOKEN=your_ngrok_authtoken

# Python YOLO server (must match API_KEY in firmware/camera-esp32cam/config.h)
API_KEY=change_me_long_random_key
