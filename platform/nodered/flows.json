    {
        "id": "e1221c7c4d31902f",
        "type": "function",
        "z": "2f6ea7b1a9044414",
        "name": "SlackBot Alert",
        "func": "let status = msg.payload.status;\n\nif (status === \"overload\" || status === \"unbalance\") {\n\n    msg.topic = \"chat.meMessage\"\n\n    msg.payload = {\n        channel: \"esp32\",\n        text: `🚨 ALERT: Device status is ${status.toUpperCase()}!`\n    }\n    return msg;\n}\nif (msg.payload === \"DANGER\") {\n    msg.topic = \"chat.meMessage\";\n    msg.payload = {\n        channel: \"esp32\",\n        text: \"🚨 Human detected, collision inbound\"\n    };\n    return msg;\n}\n\nreturn null;",
