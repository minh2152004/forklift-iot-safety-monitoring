    {
        "id": "22f5517e348478f5",
        "type": "function",
        "z": "2f6ea7b1a9044414",
        "name": "Payload Parser",
        "func": "let data;\ntry {\n    data = (typeof msg.payload === 'string')\n        ? JSON.parse(msg.payload)\n        : msg.payload;\n} catch (e) {\n    node.error(\"Invalid location JSON: \" + msg.payload, msg);\n    return null;\n}\n\nconst zone = data.zone || \"unknown\";\n\nconst fields = { zone_text: zone };\n\nif (data.rssi !== undefined && data.rssi !== null) {\n    const rssi = parseInt(data.rssi);\n    if (!isNaN(rssi)) {\n        fields.rssi = rssi;\n    }\n}\n\nif (data.minor !== undefined && data.minor !== null) {\n    const minor = parseInt(data.minor);\n    if (!isNaN(minor)) {\n        fields.minor = minor;\n    }\n}\n\nmsg.payload = [\n    fields,\n    { zone: zone }   // tag\n];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
