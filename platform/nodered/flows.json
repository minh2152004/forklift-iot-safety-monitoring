    {
        "id": "9a8cb8490ddf10bd",
        "type": "function",
        "z": "2f6ea7b1a9044414",
        "name": "Payload Parser",
        "func": "// Parse incoming JSON from forklift/data\nlet data;\ntry {\n    data = (typeof msg.payload === 'string')\n        ? JSON.parse(msg.payload)\n        : msg.payload;\n} catch (e) {\n    node.error(\"Invalid JSON: \" + msg.payload, msg);\n    return null;\n}\n\nconst weight = parseFloat(data.weight_kg);\nconst tilt = parseFloat(data.tilt);\nconst status = data.status;\n\n// --- Output 1: data for InfluxDB ---\nconst dataMsg = {\n    payload: {\n        weight_kg: weight,\n        tilt: parseFloat(tilt.toFixed(2)),\n        status: status\n    }\n};\n\n// --- Output 2: status for Slack alert check ---\nconst statusMsg = {\n    payload: { status: status }\n};\n\nreturn [dataMsg, statusMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
